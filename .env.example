# Copy to .env and fill in. .env is git-ignored; never commit real values.

# dev on this PC.
APP_ENV=dev
# mock = canned drafts, no paid AI calls (the default). replay = recorded real drafts, also $0.
# live = real Claude calls, and only `make record-replays` uses it (never Compose).
AI_MODE=mock
# Monthly AI spend cap in US dollars. Live calls refuse to run while this is blank.
AI_MONTHLY_CAP_USD=
# Anthropic API key, only needed when AI_MODE=live.
ANTHROPIC_API_KEY=
# Google sign-in OAuth client ID (v0.3). Set the ID, the secret and nothing else, or neither.
# Its redirect URI on this PC: http://localhost:<web port>/api/v1/auth/google/callback, where
# the web port is 5173 + 10 x PORT_OFFSET (`make ports` prints it).
GOOGLE_CLIENT_ID=
# Google sign-in OAuth client secret (v0.3).
GOOGLE_CLIENT_SECRET=
# The first admin's Google email (v0.3). It becomes the admin at its first Google sign-in, and
# only while no other admin has signed in.
BOOTSTRAP_ADMIN_EMAIL=
# AWS CLI profile Terraform signs in with (v0.3). No AWS keys go in this file.
AWS_PROFILE=
# AWS region for Terraform (v0.3).
AWS_REGION=
# 0-9: shifts every local port by 10 x n so parallel checkouts can run side by side.
PORT_OFFSET=0
# Password for the local Docker Postgres only. Never reused anywhere else.
POSTGRES_PASSWORD=localdev
# Path to the hashed private-word list the go-public check reads (kept outside the repo).
PRIVATE_WORDS_FILE=
